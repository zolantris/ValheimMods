<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../src/ValheimRAFT.Unity/Assets/ValheimVehicles/SharedScripts/ConvexHullCalculator.cs" Link="ConvexHullCalculator.cs" />
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(UnityManagedDirectory)/UnityEngine.CoreModule.dll</HintPath>
    </Reference>
  </ItemGroup>
  <Target Name="RequireUnityAssembly" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(UnityManagedDirectory)/UnityEngine.CoreModule.dll')"
           Text="Set UnityManagedDirectory to the Valheim or Unity Managed directory." />
  </Target>
</Project>
